{
  "name": "@hughescr/stryker-bun-runner",
  "version": "1.3.5",
  "description": "Stryker test runner plugin for Bun with perTest coverage support",
  "keywords": [
    "stryker",
    "stryker-plugin",
    "bun",
    "test-runner",
    "mutation-testing"
  ],
  "homepage": "https://github.com/hughescr/stryker-bun-runner#readme",
  "bugs": {
    "url": "https://github.com/hughescr/stryker-bun-runner/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hughescr/stryker-bun-runner.git"
  },
  "license": "Apache-2.0",
  "author": "hughescr",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target node --format esm && bun build src/coverage/preload-logic.ts --outdir dist/coverage --target bun --format esm && dts-bundle-generator --config dts-bundle-generator.config.json && cp -r src/templates dist/",
    "lint": "eslint --cache --format unix .",
    "mutate": "stryker run",
    "prepublishOnly": "bun run build",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "postversion": "git commit -m \"Bump package version to $npm_package_version\" package.json; git flow release start $npm_package_version; git flow release finish -m $npm_package_version $npm_package_version; git checkout develop; git merge main"
  },
  "dependencies": {
    "@stryker-mutator/api": "9.6.1",
    "smol-toml": "1.7.0",
    "tinyglobby": "0.2.17",
    "ws": "8.21.0"
  },
  "devDependencies": {
    "@hughescr/eslint-config-default": "6.0.1",
    "@stryker-mutator/core": "9.6.1",
    "@stryker-mutator/typescript-checker": "9.6.1",
    "@types/bun": "1.3.14",
    "@types/node": "26.1.1",
    "@types/ws": "8.18.1",
    "dts-bundle-generator": "9.5.1",
    "eslint": "10.7.0",
    "eslint-formatter-overview": "2.0.0",
    "eslint-formatter-unix": "9.0.1",
    "typescript": "<7.0.0"
  },
  "peerDependencies": {
    "@stryker-mutator/core": "^9.0.0"
  },
  "engines": {
    "bun": ">=1.3.7"
  }
}
